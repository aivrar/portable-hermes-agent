# This repository holds only the portable wrapper. START.bat installs the
# Hermes core (NousResearch/hermes-agent) into the same folder, and the
# installer and Hermes keep their runtime data here too (python_embedded,
# .portable, .hermes, .env, ...). So git ignores everything, and the wrapper's
# own paths are allowed back in below. They follow portable_hermes/ownership.py;
# tests/portable/test_portable_repository.py checks that every tracked file is
# allowed and that core and user paths stay ignored.

/*

# Wrapper and development files at the top level
!/.gitattributes
!/.gitignore
!/LICENSE
!/README*.md
!/START.bat
!/START_HERE.txt
!/UPDATE.bat
!/build_release.py
!/hermes.bat
!/hermes_gui.bat
!/hermes_gui.vbs
!/install.bat
!/pytest.ini

# Folders only the wrapper has
!/.github/
!/gui/
!/portable_hermes/
!/tests/

# Wrapper files inside folders the core also fills
!/assets/
/assets/*
!/assets/SOUL.md

!/docs/
/docs/*
!/docs/hermes-guide.md
!/docs/portable-release-checklist.md
!/docs/Portable-Hermes-Agent-Manual.pdf

!/skills/
/skills/*
!/skills/extensions/
!/skills/getting-started/
!/skills/lm-studio/

!/tools/
/tools/*
!/tools/extension_tools.py
!/tools/gpu_tool.py
!/tools/guide_tool.py
!/tools/lm_studio_tools.py
!/tools/model_switcher_tool.py
!/tools/run_python_tool.py
!/tools/serper_search_tool.py
!/tools/tool_maker.py
!/tools/update_hermes_tool.py
!/tools/workflow_tool.py

# Generated inside wrapper folders: Python caches, and what the release
# builder adds to a release (never committed)
__pycache__/
*.py[cod]
/portable_hermes/payload/
/portable_hermes/release.json
